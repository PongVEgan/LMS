# คัดลอกเป็น .env (ค่าเดียวกับ docker-compose.yml)
DATABASE_URL=postgres://lms:lms@localhost:5433/lms
PORT=3001
# โดเมนของ frontend ที่อนุญาตให้เรียก API
CORS_ORIGIN=http://localhost:3000

# Cloudinary (อัปโหลดรูป) — เอาค่าจาก Dashboard > Product Environment Credentials
# ไม่ตั้งค่า = ปุ่มอัปโหลดรูปจะแจ้งว่ายังไม่ได้ตั้งค่า แต่ส่วนอื่นใช้งานได้ปกติ
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
