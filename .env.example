# คัดลอกเป็น .env.local แล้วเติมค่าจริง

# next-auth
AUTH_SECRET=                        # openssl rand -base64 32
AUTH_TRUST_HOST=true

# backend API (ไม่ตั้งค่า = http://localhost:3001/api)
LMS_API_URL=http://localhost:3001/api
NEXT_PUBLIC_LMS_API_URL=http://localhost:3001/api

# ชื่อที่แสดงบน sidebar / title (ไม่ตั้งค่า = "LMS")
NEXT_PUBLIC_SITE_NAME=LMS


# Cloudflare Turnstile — เว้นว่างไว้ = ไม่ใช้ Turnstile ในหน้า login/register
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
